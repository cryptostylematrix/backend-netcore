# Contracts API. Do not put credentials or real production values in this template.
PROGRAM_INVITER_CHANGER_API_BASE_URL="https://API_HOST"

# Programs PostgreSQL database. The real .env file is ignored by Git.
PROGRAM_INVITER_CHANGER_CONNECTION_STRING="Host=DB_HOST;Port=5432;Database=DATABASE;Username=DB_USER;Password=DB_PASSWORD"

# Minimum delay between contracts API requests.
PROGRAM_INVITER_CHANGER_REQUEST_DELAY_MS="120"
