# Contracts API used to read Invite and Profile contracts.
PROGRAM_MIGRATOR_API_BASE_URL=http://localhost:5004

# Destination referral program. Copy this file to an ignored .env file and fill it.
PROGRAM_MIGRATOR_MARKETING_ADDR=
PROGRAM_MIGRATOR_PROGRAM_ID=
PROGRAM_MIGRATOR_SCOPE=invite

# Set either the root profile address or login. Address takes precedence.
PROGRAM_MIGRATOR_ROOT_PROFILE_ADDR=
PROGRAM_MIGRATOR_ROOT_PROFILE_LOGIN=

# Legacy Matrix database. It contains Multi and Neo legacy tables.
PROGRAM_MIGRATOR_SOURCE_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD

# Destination ReferralProgram database. Used only with --apply.
PROGRAM_MIGRATOR_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD

# Used only for Neo. It defaults to the destination marketing address.
PROGRAM_MIGRATOR_SOURCE_MARKETING_ADDR=

PROGRAM_MIGRATOR_MAX_INVITES=100000
PROGRAM_MIGRATOR_REQUEST_DELAY_MS=120
