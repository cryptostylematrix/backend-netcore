# Contracts API. Keep production endpoints and credentials out of this template.
PROGRAM_PLACE_OWNER_CHANGER_API_BASE_URL=http://localhost:5004

# Programs PostgreSQL database. Copy this file to .env and replace placeholders.
PROGRAM_PLACE_OWNER_CHANGER_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD

# Minimum delay between contracts API requests.
PROGRAM_PLACE_OWNER_CHANGER_REQUEST_DELAY_MS=120
