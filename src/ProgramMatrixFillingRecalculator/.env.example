# PostgreSQL connection string for the Referral Program database.
# Never commit a real password.
PROGRAM_MATRIX_FILLING_CONNECTION_STRING=Host=localhost;Port=5432;Database=cs_programs;Username=program_user;Password=replace_me

# Optional: process only this Referral Program. Leave unset to process all
# Referral Programs in the database.
# PROGRAM_MATRIX_FILLING_MARKETING_ADDR=REPLACE_WITH_MARKETING_ADDRESS
