# Database connections
# Matrix and Marketing share the Matrix database. Programs and Tasks use their own databases.
# UI can use a separate database; when empty, it falls back to Programs.
ConnectionStrings__Matrix=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD
ConnectionStrings__Programs=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD
ConnectionStrings__Tasks=Host=127.0.0.1;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD
ConnectionStrings__UI=

# TON contract addresses
TonContractAddresses__MultiAddr=
TonContractAddresses__ProfileCollectionAddr=

# TonCenter API and request throttling
TonCenter__Endpoint=
TonCenter__ApiKey=
TonCenter__RequestsPerSecond=10
TonCenter__QueueLimit=100
TonCenter__AcquireTimeoutMs=30000

# Processor wallet
# Keep the real mnemonic only in an ignored environment file or secret store.
ProcessorWallet__Mnemonic=

# Referral-program background task processor
TaskProcessor__IntervalSeconds=5

# TON query-cache settings
TonQueryCache__KeyPrefix=ton-query
TonQueryCache__LongTtlDays=30
TonQueryCache__NftDataIsInitMinusOneTtlDays=1
TonQueryCache__PlaceDataFilledTtlDays=1

# Seq logging (production only)
# The API ignores these settings outside the Production environment.
SEQ_URL=
SEQ_API_KEY=
