{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CryptoStyle.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build CryptoStyle.Api",
      "program": "${workspaceFolder}/src/API/CryptoStyle.Api/bin/Debug/net10.0/CryptoStyle.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/API/CryptoStyle.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "justMyCode": true,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5004"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "Attach to .NET process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
